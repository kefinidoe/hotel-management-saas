# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/
out/
coverage/
.cache/

# Supabase temporary files
supabase/.temp/
supabase/.branches/

# Hosting and framework output
.vercel/
.netlify/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Archives
*.zip
*.rar
*.7z
# TypeScript incremental build info (tsconfig has "incremental": true).
# A glob, not just tsconfig.tsbuildinfo, so any future build-info file is covered.
*.tsbuildinfo

# Database dumps. These contain real guest data -- never commit them.
backups/

# Local recovery files: retain locally, never commit
*.backup
*.backup-*
*.bak
*.patch
*.old
*.orig
*.tsbuildinfo
*.before-github-setup

# Existing client branding - do not publish in SaaS repository
/public/axis-hotel-logo.png
/public/axis-hotel-mark.png

# Additional recovery copies - keep local, do not commit
*.recovery-copy
*.pre-rewrite-backup
