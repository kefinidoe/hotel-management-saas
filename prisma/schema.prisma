// Hotel Management SaaS — Multi-Tenant Data Model
// PostgreSQL, UUID primary keys, timestamps, row-isolated tenancy via Hotel & HotelMembership
// Features DATABASE-LEVEL COMPOSITE FOREIGN KEYS for strict cross-tenant referential integrity.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// PLATFORM & TENANCY (HOTEL & MEMBERSHIP)
// ===========================================================================

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_BILLING
}

enum HotelRole {
  HOTEL_OWNER
  HOTEL_ADMIN
  MANAGER
  RECEPTIONIST
  ACCOUNTANT
  HOUSEKEEPER
  WAITER
  CASHIER
  TECHNICIAN
}

enum HotelStatus {
  ACTIVE
  TRIALING
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

model Hotel {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  logo      String?
  email     String?
  phone     String?
  address   String?
  currency  String      @default("KES")
  timezone  String      @default("Africa/Nairobi")
  settings  Json?
  status    HotelStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  subscription       Subscription?
  memberships        HotelMembership[]
  roomTypes          RoomType[]
  rooms              Room[]
  guests             Guest[]
  reservations       Reservation[]
  folios             Folio[]
  paymentMethods     PaymentMethod[]
  payments           Payment[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  menuCategories     MenuCategory[]
  menuItems          MenuItem[]
  orders             Order[]
  inventoryItems     InventoryItem[]
  inventoryRequests  InventoryRequest[]
  stockMovements     StockMovement[]
  purchases          Purchase[]
  wastages           Wastage[]
  expenses           Expense[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  // Pricing configuration (all tenant-scoped; see docs/pricing-engine-design.md)
  occupancyTypes     OccupancyType[]
  roomTypeOccupancies RoomTypeOccupancy[]
  mealPlanConfigs    MealPlanConfig[]
  mealPlanRoomTypes  MealPlanRoomType[]
  rateAdjustments    RateAdjustment[]
  extraBedRules      ExtraBedRule[]
  childPricingRules  ChildPricingRule[]
  taxRules           TaxRule[]
  pricingSettings    HotelPricingSettings?
  priceSnapshots     ReservationPriceSnapshot[]
  priceChanges       ReservationPriceChange[]
  stayExtensions     ReservationExtension[]

  @@index([status])
}

model Subscription {
  id                    String             @id @default(uuid())
  hotelId               String             @unique
  hotel                 Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  planId                String             @default("STARTER")
  status                SubscriptionStatus @default(TRIALING)
  trialStartsAt         DateTime           @default(now())
  trialEndsAt           DateTime?
  currentPeriodStartsAt DateTime           @default(now())
  currentPeriodEndsAt   DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  suspendedAt           DateTime?
  suspensionReason      String?
  billingInterval       BillingInterval    @default(MONTHLY)
  amount                Decimal            @default(0.00) @db.Decimal(10, 2)
  currency              String             @default("KES")
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status])
  @@index([planId])
  @@index([trialEndsAt])
  @@index([currentPeriodEndsAt])
}

model HotelMembership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  role       HotelRole
  department String?
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, hotelId])
  @@index([hotelId, role])
  @@index([userId, status])
}

// ===========================================================================
// GLOBAL IDENTITY (USER)
// ===========================================================================

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  platformRole PlatformRole? // NULL for standard hotel staff; non-null for SaaS platform operators
  department   String?       // Legacy profile field; hotel staff departments live on HotelMembership.
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships         HotelMembership[]
  reservationsCreated Reservation[]       @relation("ReservationCreatedBy")
  stayExtensionsApproved ReservationExtension[] @relation("ReservationExtensionApprovedBy")
  paymentsCashiered   Payment[]           @relation("PaymentCashier")
  housekeepingTasks   HousekeepingTask[]  @relation("HousekeepingAssignee")
  maintenanceTickets  MaintenanceTicket[] @relation("MaintenanceAssignee")
  auditLogs           AuditLog[]
  expensesRequested   Expense[]           @relation("ExpenseRequestedBy")
  purchasesRecorded   Purchase[]          @relation("PurchaseCreatedBy")
  wastagesRecorded    Wastage[]           @relation("WastageRecordedBy")
  wastagesAccountable Wastage[]           @relation("WastageAccountable")
  stockMovements      StockMovement[]     @relation("StockMovementUser")
  notifications       Notification[]
}

// ===========================================================================
// ROOMS & RATES (HOTEL-SCOPED)
// ===========================================================================

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  READY
  MAINTENANCE
  OUT_OF_ORDER
}

enum MealPlan {
  BED_ONLY
  BED_AND_BREAKFAST
  HALF_BOARD
}

model RoomType {
  id          String    @id @default(uuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String // e.g. "Single — Bed Only", "Double — B&B"
  description String?
  baseRate    Decimal   @db.Decimal(10, 2)
  capacity    Int       @default(2)
  mealPlan    MealPlan?
  amenities   String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rooms Room[]

  occupancyRates  RoomTypeOccupancy[]
  mealPlanLinks   MealPlanRoomType[]
  extraBedRules   ExtraBedRule[]
  rateAdjustments RateAdjustment[]

  @@unique([id, hotelId])
  @@index([hotelId])
}

model Room {
  id         String     @id @default(uuid())
  hotelId    String
  hotel      Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  number     String
  floor      String?
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId, hotelId], references: [id, hotelId])
  status     RoomStatus @default(AVAILABLE)
  isActive   Boolean    @default(true)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  reservationRooms   ReservationRoom[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([hotelId, number])
  @@unique([id, hotelId])
  @@index([hotelId, status])
  @@index([hotelId, isActive])
}

// ===========================================================================
// GUESTS & RESERVATIONS (HOTEL-SCOPED)
// ===========================================================================

model Guest {
  id                  String   @id @default(uuid())
  hotelId             String
  hotel               Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  fullName            String
  phone               String?
  email               String?
  idNumber            String?
  nationality         String?
  vehicleRegistration String?
  notes               String?
  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reservations Reservation[]
  folios       Folio[]

  @@unique([id, hotelId])
  @@index([hotelId, fullName])
  @@index([hotelId, isArchived])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WALK_IN
  PHONE
  WEBSITE
  OTA
  CORPORATE
  OTHER
}

model Reservation {
  id          String            @id @default(uuid())
  hotelId     String
  hotel       Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code        String // e.g. RES-2026-00125
  guestId     String
  guest       Guest             @relation(fields: [guestId, hotelId], references: [id, hotelId])
  checkInDate DateTime
  checkOutDate DateTime
  status      ReservationStatus @default(PENDING)
  source      BookingSource     @default(WALK_IN)
  adults      Int               @default(1)
  children    Int               @default(0)
  paymentMode String? // captured at check-in, e.g. "Cash", "M-Pesa"
  discount    Decimal?          @db.Decimal(10, 2)
  notes       String?
  createdById String
  createdBy   User              @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  rooms  ReservationRoom[]
  folios Folio[]
  // Append-only pricing history: version 1 is the price agreed at creation,
  // each repricing appends a new immutable version. The current price is the
  // highest version.
  priceSnapshots ReservationPriceSnapshot[]
  priceChanges   ReservationPriceChange[]
  // Approved stay extensions. An extension is not a repricing: the agreed stay
  // stays frozen as it was, and each extension is recorded as its own bounded
  // financial event with the nights, rate and amount it added.
  stayExtensions ReservationExtension[]

  @@unique([hotelId, code])
  @@unique([id, hotelId])
  @@index([hotelId, checkInDate])
  @@index([hotelId, checkOutDate])
  @@index([hotelId, status])
}

// Join table: a reservation can cover multiple rooms
// Tenant ownership is inherited via parent Reservation.
model ReservationRoom {
  id            String      @id @default(uuid())
  reservationId String
  hotelId       String
  reservation   Reservation @relation(fields: [reservationId, hotelId], references: [id, hotelId], onDelete: Cascade)
  roomId        String
  room          Room        @relation(fields: [roomId, hotelId], references: [id, hotelId])
  rate          Decimal     @db.Decimal(10, 2)

  @@unique([reservationId, roomId])
  @@index([hotelId])
  // Child-side index for the (roomId, hotelId) foreign key.
  @@index([roomId, hotelId])
}

// ===========================================================================
// BILLING & PAYMENTS (HOTEL-SCOPED)
// ===========================================================================

model Folio {
  id            String       @id @default(uuid())
  hotelId       String
  hotel         Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestId       String
  guest         Guest        @relation(fields: [guestId, hotelId], references: [id, hotelId])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId, hotelId], references: [id, hotelId])
  isClosed      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items    FolioItem[]
  payments Payment[]
  orders   Order[]

  @@unique([id, hotelId])
  @@index([hotelId, isClosed])
  @@index([hotelId, reservationId])
}

enum FolioItemType {
  ROOM_CHARGE
  RESTAURANT
  LAUNDRY
  OTHER_SERVICE
  DISCOUNT
  TAX
}

// Inherited tenant ownership strictly via parent Folio
model FolioItem {
  id          String        @id @default(uuid())
  folioId     String
  folio       Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)
  type        FolioItemType
  description String
  quantity    Int           @default(1)
  unitPrice   Decimal       @db.Decimal(10, 2)
  taxRate     Decimal       @db.Decimal(5, 2) @default(0)
  total       Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())

  @@index([folioId, type])
  @@index([type, createdAt])
}

model PaymentMethod {
  id       String    @id @default(uuid())
  hotelId  String
  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name     String // Cash, M-Pesa, Card, Bank Transfer...
  isActive Boolean   @default(true)

  payments Payment[]
  orders   Order[]

  @@unique([hotelId, name])
  @@unique([id, hotelId])
  @@index([hotelId, isActive])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  hotelId         String
  hotel           Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  folioId         String
  folio           Folio         @relation(fields: [folioId, hotelId], references: [id, hotelId])
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId, hotelId], references: [id, hotelId])
  amount          Decimal       @db.Decimal(10, 2)
  reference       String? // e.g. M-Pesa code
  idempotencyKey  String?
  requestFingerprint String?
  status          PaymentStatus @default(COMPLETED)
  cashierId       String
  cashier         User          @relation("PaymentCashier", fields: [cashierId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([id, hotelId])
  @@unique([hotelId, idempotencyKey])
  @@index([hotelId, createdAt])
  @@index([hotelId, folioId])
}

// ===========================================================================
// HOUSEKEEPING & MAINTENANCE (HOTEL-SCOPED)
// ===========================================================================

enum HousekeepingStatus {
  NEEDS_CLEANING
  IN_PROGRESS
  READY_FOR_INSPECTION
  READY
}

model HousekeepingTask {
  id         String             @id @default(uuid())
  hotelId    String
  hotel      Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId     String
  room       Room               @relation(fields: [roomId, hotelId], references: [id, hotelId])
  status     HousekeepingStatus @default(NEEDS_CLEANING)
  assigneeId String?
  assignee   User?              @relation("HousekeepingAssignee", fields: [assigneeId], references: [id])
  priority   String             @default("normal") // low | normal | high
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([hotelId, status])
  @@index([hotelId, roomId])
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
}

model MaintenanceTicket {
  id          String            @id @default(uuid())
  hotelId     String
  hotel       Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId      String?
  room        Room?             @relation(fields: [roomId, hotelId], references: [id, hotelId])
  title       String
  description String?
  priority    String            @default("normal") // low | normal | high
  status      MaintenanceStatus @default(OPEN)
  assigneeId  String?
  assignee    User?             @relation("MaintenanceAssignee", fields: [assigneeId], references: [id])
  cost        Decimal?          @db.Decimal(10, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([hotelId, status])
  @@index([hotelId, roomId])
}

// ===========================================================================
// RESTAURANT / POS (HOTEL-SCOPED)
// ===========================================================================

model MenuCategory {
  id      String     @id @default(uuid())
  hotelId String
  hotel   Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name    String
  items   MenuItem[]

  @@unique([hotelId, name])
  @@unique([id, hotelId])
  @@index([hotelId])
}

model MenuItem {
  id         String       @id @default(uuid())
  hotelId    String
  hotel      Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory @relation(fields: [categoryId, hotelId], references: [id, hotelId])
  name       String
  price      Decimal      @db.Decimal(10, 2)
  isActive   Boolean      @default(true)
  recipe     Recipe?
  orderItems OrderItem[]

  @@unique([id, hotelId])
  @@index([hotelId, categoryId, isActive])
  @@index([hotelId, isActive])
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

model Order {
  id                    String         @id @default(uuid())
  hotelId               String
  hotel                 Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  status                OrderStatus    @default(PAID)
  paymentMethodId       String?
  paymentMethod         PaymentMethod? @relation(fields: [paymentMethodId, hotelId], references: [id, hotelId])
  folioId               String?
  folio                 Folio?         @relation(fields: [folioId, hotelId], references: [id, hotelId])
  total                 Decimal        @db.Decimal(10, 2)
  idempotencyOperation  String?
  idempotencyKey        String?
  requestFingerprint    String?
  createdAt             DateTime       @default(now())
  items                 OrderItem[]

  @@unique([id, hotelId])
  @@unique([hotelId, idempotencyOperation, idempotencyKey])
  @@index([hotelId, createdAt])
  @@index([hotelId, folioId])
}

// The tenant key is copied from Order so both the order and optional menu-item
// references can be enforced with composite foreign keys.
model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  hotelId    String
  order      Order     @relation(fields: [orderId, hotelId], references: [id, hotelId], onDelete: Restrict)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId, hotelId], references: [id, hotelId], onDelete: Restrict)
  name       String
  unitPrice  Decimal   @db.Decimal(10, 2)
  quantity   Int
  total      Decimal   @db.Decimal(10, 2)

  @@index([orderId])
  // Child-side index for the (menuItemId, hotelId) foreign key.
  @@index([menuItemId, hotelId])
}

// ===========================================================================
// INVENTORY & RECIPES (HOTEL-SCOPED)
// ===========================================================================

// Durable replay ledger for tenant-scoped inventory mutations.
model InventoryRequest {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  operation   String
  requestKey  String
  fingerprint String
  response    Json
  statusCode  Int
  createdAt   DateTime @default(now())

  @@unique([hotelId, operation, requestKey])
}

model InventoryItem {
  id           String   @id @default(uuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  sku          String
  name         String
  category     String
  unit         String // base unit: "g" | "ml" | "pcs"
  currentStock Decimal  @default(0) @db.Decimal(12, 2)
  stockVersion Int      @default(0)
  reorderLevel Decimal  @default(0) @db.Decimal(12, 2)
  costPerUnit  Decimal  @default(0) @db.Decimal(10, 4)
  supplier     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  wastages          Wastage[]

  @@unique([hotelId, sku])
  @@unique([id, hotelId])
  @@index([hotelId, category])
  @@index([hotelId, isActive])
}

// The tenant key allows both recipe relationships to be protected by the DB.
model Recipe {
  id         String   @id @default(uuid())
  menuItemId String   @unique
  hotelId    String
  menuItem   MenuItem @relation(fields: [menuItemId, hotelId], references: [id, hotelId], onDelete: Restrict)
  portions   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ingredients RecipeIngredient[]

  @@unique([id, hotelId])
  @@unique([menuItemId, hotelId])
}

model RecipeIngredient {
  id              String        @id @default(uuid())
  recipeId        String
  inventoryItemId String
  hotelId         String
  recipe          Recipe        @relation(fields: [recipeId, hotelId], references: [id, hotelId], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId, hotelId], references: [id, hotelId])
  quantity        Decimal       @db.Decimal(10, 2)

  @@unique([recipeId, inventoryItemId])
  // Child-side index for the (inventoryItemId, hotelId) foreign key.
  @@index([inventoryItemId, hotelId])
}

enum StockMovementType {
  PURCHASE
  MEAL_SALE
  WASTAGE
  ADJUSTMENT
  OPENING_BALANCE
}

model StockMovement {
  id              String            @id @default(uuid())
  hotelId         String
  hotel           Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId, hotelId], references: [id, hotelId])
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 2)
  beforeQty       Decimal           @db.Decimal(12, 2)
  afterQty        Decimal           @db.Decimal(12, 2)
  reference       String?
  userId          String?
  user            User?             @relation("StockMovementUser", fields: [userId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([hotelId, createdAt])
  @@index([hotelId, inventoryItemId])
}

model Purchase {
  id              String        @id @default(uuid())
  hotelId         String
  hotel           Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId, hotelId], references: [id, hotelId])
  supplier        String
  invoiceNumber   String?
  quantity        Decimal       @db.Decimal(12, 2)
  unitCost        Decimal       @db.Decimal(10, 4)
  totalCost       Decimal       @db.Decimal(10, 2)
  purchaseDate    DateTime      @default(now())
  createdById     String
  createdBy       User          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([hotelId, purchaseDate])
  @@index([hotelId, inventoryItemId])
}

enum WastageReason {
  SPOILAGE
  EXPIRED
  BURNT
  DAMAGED
  PREP_WASTE
  OTHER
}

model Wastage {
  id                String        @id @default(uuid())
  hotelId           String
  hotel             Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId, hotelId], references: [id, hotelId])
  quantity          Decimal       @db.Decimal(12, 2)
  reason            WastageReason
  department        String?
  recordedById      String
  recordedBy        User          @relation("WastageRecordedBy", fields: [recordedById], references: [id])
  accountableUserId String?
  accountableUser   User?         @relation("WastageAccountable", fields: [accountableUserId], references: [id], onDelete: SetNull)
  accountableName   String?
  createdAt         DateTime      @default(now())

  @@index([hotelId, createdAt])
  @@index([accountableUserId])
  @@index([hotelId, inventoryItemId])
}

// ===========================================================================
// EXPENSES (HOTEL-SCOPED)
// ===========================================================================

enum ExpenseStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Expense {
  id            String        @id @default(uuid())
  hotelId       String
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category      String
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod String
  supplier      String?
  reference     String?
  status        ExpenseStatus @default(APPROVED)
  requestedById String
  requestedBy   User          @relation("ExpenseRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([hotelId, createdAt])
  @@index([hotelId, status])
}

// ===========================================================================
// NOTIFICATIONS & AUDIT LOGS (REDESIGNED)
// ===========================================================================

enum NotificationType {
  SYSTEM
  RESERVATION
  HOUSEKEEPING
  MAINTENANCE
  STOCK_ALERT
  BILLING
}

model Notification {
  id        String           @id @default(uuid())
  hotelId   String
  hotel     Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String? // null = broadcast to all hotel staff; set = targeted user
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([hotelId, isRead])
  @@index([hotelId, userId, isRead])
  @@index([hotelId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  hotelId   String? // null = platform-level event; set = hotel-scoped event
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String? // null = system action
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([hotelId, entity, entityId])
}

// ===========================================================================
// PRICING ENGINE (HOTEL-SCOPED CONFIGURATION)
//
// Every model here is tenant-owned. Hotel-scoped records carry hotelId directly
// and (where another pricing table references them) an `@@unique([id, hotelId])`
// target so the reference itself is composite — a foreign key cannot point at
// another hotel's row even if application code tried to.
//
// Nothing here replaces RoomType.baseRate: a hotel that has not configured
// occupancy rates keeps working on its existing base rate (LEGACY_BASE_RATE).
// ===========================================================================

enum MealPlanPricingBasis {
  PER_PERSON_PER_NIGHT
  PER_ROOM_PER_NIGHT
  PER_PERSON_PER_STAY
  PER_ROOM_PER_STAY
}

enum RateAdjustmentKind {
  SEASONAL // date range
  WEEKEND  // recurring days of week
}

enum RateAdjustmentType {
  PERCENT         // multiply the nightly rate
  FIXED_PER_NIGHT // add/subtract a nightly amount
  SET_RATE        // replace the nightly rate with a fixed amount
}

enum ChildChargeType {
  FIXED_PER_NIGHT
  PERCENT_OF_ADULT
}

enum TaxBasis {
  PERCENT
  FIXED
}

enum TaxAppliesTo {
  ROOM
  MEALS
  ALL
}

enum TaxChargeBasis {
  PER_NIGHT
  PER_STAY
  PER_PERSON_PER_NIGHT
}

enum PricingModel {
  ROOM_TYPE_OCCUPANCY // configured occupancy rates below
  LEGACY_BASE_RATE    // RoomType.baseRate, unchanged behaviour
}

/// A hotel's own occupancy options ("Single", "Double", "Twin", "Family", ...).
/// Nothing is global: two hotels may name or price occupancies differently.
model OccupancyType {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  minAdults   Int      @default(1)
  maxAdults   Int      @default(4)
  maxChildren Int      @default(0)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomTypeRates RoomTypeOccupancy[]

  @@unique([id, hotelId])
  @@unique([hotelId, name])
  @@index([hotelId, isActive])
}

/// The nightly rate for one occupancy option of one room type.
model RoomTypeOccupancy {
  id              String        @id @default(uuid())
  hotelId         String
  hotel           Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId      String
  roomType        RoomType      @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Cascade)
  occupancyTypeId String
  occupancyType   OccupancyType @relation(fields: [occupancyTypeId, hotelId], references: [id, hotelId], onDelete: Cascade)
  nightlyRate     Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([roomTypeId, occupancyTypeId])
  @@index([hotelId, roomTypeId])
  @@index([occupancyTypeId, hotelId])
}

/// A hotel-defined meal plan with its own pricing basis and charge.
model MealPlanConfig {
  id             String               @id @default(uuid())
  hotelId        String
  hotel          Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  includedItems  String[]             @default([])
  pricingBasis   MealPlanPricingBasis @default(PER_PERSON_PER_NIGHT)
  charge         Decimal              @db.Decimal(10, 2) @default(0)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  sortOrder      Int                  @default(0)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  roomTypes MealPlanRoomType[]

  @@unique([id, hotelId])
  @@unique([hotelId, name])
  @@index([hotelId, isActive])
}

/// Restricts a meal plan to specific room types. No rows = available to all.
model MealPlanRoomType {
  id         String         @id @default(uuid())
  hotelId    String
  hotel      Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  mealPlanId String
  mealPlan   MealPlanConfig @relation(fields: [mealPlanId, hotelId], references: [id, hotelId], onDelete: Cascade)
  roomTypeId String
  roomType   RoomType       @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Cascade)

  @@unique([mealPlanId, roomTypeId])
  @@index([hotelId, roomTypeId])
}

/// Seasonal and weekend rate adjustments. `roomTypeId` = null applies to all
/// room types; `daysOfWeek` (0 = Sunday) is used by WEEKEND rows.
model RateAdjustment {
  id             String             @id @default(uuid())
  hotelId        String
  hotel          Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId     String?
  roomType       RoomType?          @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Cascade)
  name           String
  kind           RateAdjustmentKind
  adjustmentType RateAdjustmentType
  amount         Decimal            @db.Decimal(10, 2)
  daysOfWeek     Int[]              @default([])
  startDate      DateTime?
  endDate        DateTime?
  priority       Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([id, hotelId])
  @@index([hotelId, kind, isActive])
  @@index([hotelId, roomTypeId])
}

model ExtraBedRule {
  id          String    @id @default(uuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId  String?
  roomType    RoomType? @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Cascade)
  name        String
  nightlyRate Decimal   @db.Decimal(10, 2)
  childRate   Decimal?  @db.Decimal(10, 2)
  maxPerRoom  Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([id, hotelId])
  @@index([hotelId, isActive])
}

model ChildPricingRule {
  id         String          @id @default(uuid())
  hotelId    String
  hotel      Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name       String
  minAge     Int             @default(0)
  maxAge     Int             @default(12)
  chargeType ChildChargeType @default(FIXED_PER_NIGHT)
  amount     Decimal         @db.Decimal(10, 2)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([id, hotelId])
  @@index([hotelId, isActive])
}

model TaxRule {
  id         String          @id @default(uuid())
  hotelId    String
  hotel      Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name       String
  basis      TaxBasis        @default(PERCENT)
  amount     Decimal         @db.Decimal(10, 2)
  appliesTo  TaxAppliesTo    @default(ALL)
  chargeBasis TaxChargeBasis  @default(PER_STAY)
  isInclusive Boolean        @default(false)
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([id, hotelId])
  @@index([hotelId, isActive])
}

/// Which pricing features a hotel actually uses, plus its tax posture.
model HotelPricingSettings {
  id                  String       @id @default(uuid())
  hotelId             String       @unique
  hotel               Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  pricingModel        PricingModel @default(LEGACY_BASE_RATE)
  useOccupancyRates   Boolean      @default(false)
  useMealPlans        Boolean      @default(false)
  useSeasonalPricing  Boolean      @default(false)
  useWeekendPricing   Boolean      @default(false)
  useChildPricing     Boolean      @default(false)
  useExtraBeds        Boolean      @default(false)
  useTaxes            Boolean      @default(false)
  pricesIncludeTax    Boolean      @default(false)
  updatedAt           DateTime     @updatedAt
  createdAt           DateTime     @default(now())
}

/// One immutable version of a reservation's agreed price.
///
/// Version 1 is written when the reservation is created; every repricing appends
/// the next version. Rows are never updated (a database trigger enforces this),
/// so the original agreement — amount, currency, breakdown, occupancy, meal plan
/// and the actor who made it — survives every later repricing.
model ReservationPriceSnapshot {
  id             String      @id @default(uuid())
  hotelId        String
  // Financial evidence outlives a hotel row: deleting a hotel must not erase it.
  hotel          Hotel       @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reservationId  String
  // A reservation cannot be deleted while pricing versions exist; the deletion
  // path has to remove them deliberately.
  reservation    Reservation @relation(fields: [reservationId, hotelId], references: [id, hotelId], onDelete: Restrict)
  /// 1 = the original agreement, 2.. = later repricings.
  version        Int         @default(1)

  pricingModel   PricingModel
  currency       String
  occupancyName  String?
  mealPlanName   String?
  mealPlanBasis  MealPlanPricingBasis?
  nightlyRate    Decimal     @db.Decimal(10, 2)
  nights         Int
  adults         Int         @default(1)
  children       Int         @default(0)
  extraBeds      Int         @default(0)
  roomTotal      Decimal     @db.Decimal(10, 2)
  mealsTotal     Decimal     @db.Decimal(10, 2) @default(0)
  extrasTotal    Decimal     @db.Decimal(10, 2) @default(0)
  adjustmentsTotal Decimal   @db.Decimal(10, 2) @default(0)
  discountTotal  Decimal     @db.Decimal(10, 2) @default(0)
  taxTotal       Decimal     @db.Decimal(10, 2) @default(0)
  grandTotal     Decimal     @db.Decimal(10, 2)
  breakdown      Json
  createdById    String
  createdAt      DateTime    @default(now())

  @@unique([reservationId, version])
  @@index([hotelId, createdAt])
  @@index([reservationId, version])
}

/// Audit trail for explicit repricing of an existing reservation.
model ReservationPriceChange {
  id               String      @id @default(uuid())
  hotelId          String
  hotel            Hotel       @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reservationId    String
  reservation      Reservation @relation(fields: [reservationId, hotelId], references: [id, hotelId], onDelete: Restrict)
  previousTotal    Decimal     @db.Decimal(10, 2)
  newTotal         Decimal     @db.Decimal(10, 2)
  /// Versions this change moved between (null for rows written before versioning).
  previousVersion  Int?
  newVersion       Int?
  reason           String?
  breakdown        Json
  changedById      String
  createdAt        DateTime    @default(now())

  @@index([hotelId, reservationId, createdAt])
}

/// One approved extension of a stay.
///
/// An extension is deliberately *not* a repricing. `ReservationPriceChange`
/// means "the price of the same stay was re-agreed", with a previous and a new
/// total for the whole booking. Extending a stay leaves the original agreement
/// exactly as it was (version 1 of `ReservationPriceSnapshot` is untouched) and
/// adds a bounded chunk of nights at an explicitly agreed rate. Recording that
/// as a price change would misstate the event and make the folio, the snapshot
/// and the change row disagree. Each extension therefore has its own row.
model ReservationExtension {
  id               String      @id @default(uuid())
  hotelId          String
  // Financial evidence outlives the hotel row.
  hotel            Hotel       @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reservationId    String
  reservation      Reservation @relation(fields: [reservationId, hotelId], references: [id, hotelId], onDelete: Restrict)

  previousCheckOut DateTime
  newCheckOut      DateTime
  additionalNights Int
  /// The rate the extension was agreed at (the stay's own agreed rate).
  nightlyRate      Decimal     @db.Decimal(10, 2)
  additionalCharge Decimal     @db.Decimal(10, 2)
  currency         String
  /// Rooms affected: [{ roomId, number, roomTypeId, nightlyRate, nights, amount }]
  rooms            Json
  /// Folio the charge was posted to, and the exact folio lines it created.
  folioId          String
  folioItemIds     Json
  /// Booking price version the extension was added to (null for legacy hotels).
  priceVersion     Int?
  note             String?
  approvedById     String
  approvedBy       User        @relation("ReservationExtensionApprovedBy", fields: [approvedById], references: [id])
  createdAt        DateTime    @default(now())

  // One extension per checkout moment: a repeated or concurrent request that
  // starts from the same checkout date cannot post the same nights twice.
  @@unique([reservationId, previousCheckOut])
  @@index([hotelId, reservationId, createdAt])
  @@index([hotelId, createdAt])
  // Child-side index for the (reservationId, hotelId) foreign key.
  @@index([reservationId, hotelId])
}

// Shared across instances; keys are digests, never raw account or IP values.
model AuthRateLimitBucket {
  key       String   @id
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}
