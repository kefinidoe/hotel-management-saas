{
  "name": "hotel-management-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs,.cjs,.jsx,.ts,.mts,.cts,.tsx",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify-database-target.ts",
    "migration:manifest": "node scripts/migration-ledger.mjs manifest --check",
    "migration:checkpoints": "node scripts/migration-ledger.mjs checkpoints",
    "migration:adopt": "node scripts/migrate-adopt.mjs",
    "migration:rehearse": "node scripts/migration-rehearsal.mjs",
    "migration:verify-engine": "node scripts/prisma-engine-verify.mjs",
    "migration:verify-pin": "node scripts/prisma-engine-pin.mjs",
    "migration:readiness": "node scripts/migration-readiness.mjs",
    "migration:target-check": "node scripts/target-check.mjs",
    "migration:restore-rehearsal": "node scripts/restore-rehearsal.mjs",
    "db:clean": "tsx scripts/clean-test-data.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "backup": "node scripts/backup-db.mjs",
    "backup:restore": "node scripts/restore-db.mjs",
    "backup:rehearse": "node scripts/restore-rehearsal.mjs",
    "postinstall": "prisma generate",
    "db:integrity": "node scripts/db-integrity.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.17.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "fflate": "0.8.3",
    "lucide-react": "0.400.0",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@prisma/adapter-pg": "^5.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.28",
    "jsdom": "^30.0.1",
    "pg": "^8.23.1",
    "postcss": "8.5.32",
    "prisma": "5.17.0",
    "tailwindcss": "3.4.7",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@prisma/client@5.17.0": true,
    "@prisma/engines@5.17.0": true,
    "prisma@5.17.0": true,
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "postcss": "8.5.32",
    "postcss-selector-parser": "6.1.5",
    "undici": "8.12.2"
  }
}
