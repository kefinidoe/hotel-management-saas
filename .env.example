# ===========================================================================
# HOTEL MANAGEMENT SAAS - ENVIRONMENT CONFIGURATION
# ===========================================================================
# IMPORTANT: NEVER use or paste production credentials or URLs into this file.
# The SaaS database is a completely independent database.
# ===========================================================================

# Environment Identifier for Fail-Closed Database Safety Guard
# Must be strictly 'saas' — anything else or missing will abort and fail closed
SAAS_ENVIRONMENT="saas"
SAAS_DATABASE_IDENTIFIER="your-approved-saas-project-ref" # Must match Supabase project reference or database name

# ---------------------------------------------------------------------------
# Database (Independent SaaS Database)
# ---------------------------------------------------------------------------
# DATABASE_URL: Connects to the new SaaS PostgreSQL / Supabase Transaction Pooler (port 6543)
# DIRECT_URL: Connects to the new SaaS PostgreSQL / Supabase Direct Connection (port 5432)
DATABASE_URL="postgresql://postgres.saas-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres.saas-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?schema=public"

# ---------------------------------------------------------------------------
# NextAuth Authentication
# ---------------------------------------------------------------------------
# Generate a new random secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-new-independent-saas-secret"
NEXTAUTH_URL="http://localhost:3000"

# Seed safety. `npm run seed` contains one destructive step: removing the old
# placeholder rooms 101/102 created by an earlier version of the seed. By default
# it deletes nothing that a guest touched -- if those rooms carry reservations,
# folios, orders or payments, the seed skips the cleanup and reports what it
# found instead of deleting it.
#
# Set this to true only when you are certain that activity is disposable test
# data. Never set it on a database that holds real bookings:
#   SEED_ALLOW_DESTRUCTIVE_CLEANUP="true"
